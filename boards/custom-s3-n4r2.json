{
  "build": {
    "arduino":{
      "ldscript": "esp32s3_out.ld",
      "partitions": "default.csv",
      "memory_type": "qio_qspi"
    },
    "core": "esp32",
    "usb_mode": "0",
    "extra_flags": [
      "-DCUSTOM_S3_N4R2",
      "-DARDUINO_USB_CDC_ON_BOOT=0",
      "-DARDUINO_USB_MODE=0"
    ],
    "f_cpu": "240000000L",
    "f_flash": "80000000L",
    "flash_mode": "qio",
    "hwids": [
      [
        "0x1209",
        "0x7690"
      ]
    ],
    "mcu": "esp32s3",
    "variant": "custom_s3_n4r2"
  },
  "connectivity": [
    "wifi",
    "bluetooth"
  ],
  "debug": {
    "default_tool": "esp-builtin",
    "onboard_tools": [
      "esp-builtin"
    ],
    "openocd_target": "esp32s3.cfg"
  },
  "frameworks": [
    "arduino",
    "espidf"
  ],
  "name": "SlimeVR ESPNow Dongle (Custom S3-N4R2)",
  "upload": {
    "flash_size": "4MB",
    "maximum_ram_size": 520080,
    "maximum_size": 4194304,
    "require_upload_port": true,
    "speed": 921600
  },
  "url": "https://slimevr.dev",
  "vendor": "SlimeVR"
}
